{
  "description": "Korture Sense: start the reading when a session ends; when one starts, show one line if it is news and hand the AI the reading as context; on every message, tell the AI once if the number moved; after a reply that asks to go ahead or says it is done, one Sense line at most once a chat; load the handoff when the session was opened from ~/.korture/handoff; and, as a mod, the number under the prompt and each piece of news once.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session-end --harness claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session-start --harness claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" prompt --harness claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" stop --harness claude-code",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./mod.js"
  ]
}
