{
  "manifest_version": 3,
  "name": "Korture Sense",
  "version": "0.2.1",
  "description": "Hands your own Claude and ChatGPT messages to Korture Sense on your Mac, to measure how you work with AI. Nothing leaves your Mac.",
  "key": "",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://korture.ai"
}
