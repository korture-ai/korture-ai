{
  "description": "Korture Sense: when a chat starts, one line if there is news and your reading for the AI; on each message, news once; after a reply that asks to go ahead or says it is done, one line at most once a chat; when a chat ends, the reading starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" session-start --harness codex",
            "timeout": 10,
            "statusMessage": "Korture Sense: your news, once"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" prompt --harness codex",
            "timeout": 10,
            "statusMessage": "Korture Sense: news while you work"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" session-end --harness codex",
            "timeout": 3,
            "statusMessage": "Korture Sense: start your reading"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" stop --harness codex",
            "timeout": 5,
            "statusMessage": "Korture Sense: a line at the moment"
          }
        ]
      }
    ]
  }
}
